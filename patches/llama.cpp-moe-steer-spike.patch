+// SPIKE (throwaway): trace MoE expert routing, and generate with steering applied via LLAMA_EXPERT_BIAS_FILE.
+//
+//   MOE_MODE=trace MOE_PROMPTS=p.txt MOE_OUT=counts.json llama-moe-spike -m model.gguf
+//   MOE_MODE=gen   MOE_PROMPTS=p.txt MOE_OUT=out.jsonl   llama-moe-spike -m model.gguf -n 64
+//
+// Prompts are separated by lines containing exactly "---". MOE_TEMPLATE=1 wraps each prompt in the model's chat template.
+
+#include "arg.h"
+#include "common.h"
+#include "log.h"
+#include "llama.h"
+
+#include "ggml-backend.h"
+
+#include <clocale>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <map>
+#include <sstream>
+#include <string>
+#include <vector>
+
+struct trace_data {
+    std::map<int, std::vector<int64_t>> counts; // layer -> per-expert selection count
+};
+
+static bool trace_cb(ggml_tensor * t, bool ask, void * user_data) {
+    static const char prefix[] = "ffn_moe_topk-";
+    if (strncmp(t->name, prefix, sizeof(prefix) - 1) != 0) {
+        return !ask;
+    }
+    if (ask) {
+        return true;
+    }
+    auto * d = (trace_data *) user_data;
+    const int il = atoi(t->name + sizeof(prefix) - 1);
+    auto & c = d->counts[il];
+    // i32 [n_expert_used, n_tokens], possibly a non-contiguous view
+    for (int64_t j = 0; j < t->ne[1]; j++) {
+        for (int64_t k = 0; k < t->ne[0]; k++) {
+            int32_t e;
+            ggml_backend_tensor_get(t, &e, k * t->nb[0] + j * t->nb[1], sizeof(e));
+            if (e < 0) {
+                continue;
+            }
+            if ((size_t) e >= c.size()) {
+                c.resize(e + 1, 0);
+            }
+            c[e]++;
+        }
+    }
+    return true;
+}
+
+static std::vector<std::string> read_prompts(const std::string & path) {
+    std::ifstream f(path);
+    std::vector<std::string> prompts;
+    std::string line, cur;
+    while (std::getline(f, line)) {
+        if (line == "---") {
+            if (!cur.empty()) prompts.push_back(cur);
+            cur.clear();
+        } else {
+            cur += (cur.empty() ? "" : "\n") + line;
+        }
+    }
+    if (!cur.empty()) prompts.push_back(cur);
+    return prompts;
+}
+
+static std::string apply_template(const llama_model * model, const std::string & user) {
+    const char * tmpl = llama_model_chat_template(model, nullptr);
+    llama_chat_message msg = { "user", user.c_str() };
+    std::vector<char> buf(user.size() * 2 + 4096);
+    int n = llama_chat_apply_template(tmpl, &msg, 1, true, buf.data(), buf.size());
+    if (n > (int) buf.size()) {
+        buf.resize(n);
+        n = llama_chat_apply_template(tmpl, &msg, 1, true, buf.data(), buf.size());
+    }
+    return n < 0 ? user : std::string(buf.data(), n);
+}
+
+static std::string json_escape(const std::string & s) {
+    std::ostringstream o;
+    for (unsigned char ch : s) {
+        switch (ch) {
+            case '"':  o << "\\\""; break;
+            case '\\': o << "\\\\"; break;
+            case '\n': o << "\\n";  break;
+            case '\r': o << "\\r";  break;
+            case '\t': o << "\\t";  break;
+            default:
+                if (ch < 0x20) { char b[8]; snprintf(b, sizeof(b), "\\u%04x", ch); o << b; } else { o << ch; }
+        }
+    }
+    return o.str();
+}
+
+static bool decode_all(llama_context * ctx, std::vector<llama_token> & tokens, int n_batch) {
+    for (size_t i = 0; i < tokens.size(); i += n_batch) {
+        const int n = std::min((int) (tokens.size() - i), n_batch);
+        if (llama_decode(ctx, llama_batch_get_one(tokens.data() + i, n))) {
+            return false;
+        }
+    }
+    return true;
+}
+
+int main(int argc, char ** argv) {
+    std::setlocale(LC_NUMERIC, "C");
+
+    const char * mode    = getenv("MOE_MODE");
+    const char * prompts_path = getenv("MOE_PROMPTS");
+    const char * out_path = getenv("MOE_OUT");
+    const bool use_template = getenv("MOE_TEMPLATE") && atoi(getenv("MOE_TEMPLATE")) != 0;
+    if (!mode || !prompts_path || !out_path) {
+        fprintf(stderr, "set MOE_MODE (trace|gen), MOE_PROMPTS, MOE_OUT\n");
+        return 1;
+    }
+    const bool trace = strcmp(mode, "trace") == 0;
+
+    common_params params;
+    common_init();
+    if (!common_params_parse(argc, argv, params, LLAMA_EXAMPLE_COMMON)) {
+        return 1;
+    }
+    llama_backend_init();
+
+    trace_data td;
+    if (trace) {
+        params.cb_eval = trace_cb;
+        params.cb_eval_user_data = &td;
+    }
+    params.warmup = false;
+
+    auto llama_init = common_init_from_params(params);
+    auto * model = llama_init->model();
+    auto * ctx   = llama_init->context();
+    if (model == nullptr || ctx == nullptr) {
+        LOG_ERR("failed to init\n");
+        return 1;
+    }
+    const llama_vocab * vocab = llama_model_get_vocab(model);
+    const int n_predict = params.n_predict > 0 ? params.n_predict : 64;
+
+    std::ofstream out(out_path);
+    int64_t n_tokens_total = 0;
+
+    for (const auto & raw : read_prompts(prompts_path)) {
+        const std::string prompt = use_template ? apply_template(model, raw) : raw;
+        std::vector<llama_token> tokens = common_tokenize(ctx, prompt, true, true);
+        llama_memory_clear(llama_get_memory(ctx), true);
+        if (!decode_all(ctx, tokens, params.n_batch)) {
+            LOG_ERR("decode failed\n");
+            return 1;
+        }
+        n_tokens_total += tokens.size();
+        if (trace) {
+            continue;
+        }
+
+        llama_sampler * smpl = llama_sampler_init_greedy();
+        std::string text;
+        for (int i = 0; i < n_predict; i++) {
+            llama_token tok = llama_sampler_sample(smpl, ctx, -1);
+            if (llama_vocab_is_eog(vocab, tok)) {
+                break;
+            }
+            text += common_token_to_piece(ctx, tok);
+            if (llama_decode(ctx, llama_batch_get_one(&tok, 1))) {
+                LOG_ERR("decode failed\n");
+                return 1;
+            }
+        }
+        llama_sampler_free(smpl);
+        out << "{\"prompt\":\"" << json_escape(raw) << "\",\"output\":\"" << json_escape(text) << "\"}\n";
+        out.flush();
+        fprintf(stderr, "[gen] %s\n", text.substr(0, 120).c_str());
+    }
+
+    if (trace) {
+        out << "{\"n_tokens\":" << n_tokens_total << ",\"counts\":{";
+        bool first = true;
+        for (auto & [il, c] : td.counts) {
+            out << (first ? "" : ",") << "\"" << il << "\":[";
+            for (size_t e = 0; e < c.size(); e++) {
+                out << (e ? "," : "") << c[e];
+            }
+            out << "]";
+            first = false;
+        }
+        out << "}}\n";
+    }
+
+    llama_backend_free();
+    return 0;
+}
