+// SPIKE (throwaway): MoE expert routing tools.
+//
+//   MOE_MODE=trace MOE_PROMPTS=p.txt MOE_OUT=counts.json llama-moe-spike -m model.gguf
+//   MOE_MODE=gen   MOE_PROMPTS=p.txt MOE_OUT=out.jsonl   llama-moe-spike -m model.gguf -n 64
+//   MOE_MODE=serve llama-moe-spike -m model.gguf          # JSON lines on stdin/stdout
+//
+// Prompts are separated by lines containing exactly "---". MOE_TEMPLATE=1 wraps each prompt in the
+// model's chat template. Steering comes from LLAMA_EXPERT_BIAS_FILE, re-read by the engine as it changes.
+//
+// serve protocol:
+//   -> {"prompt": "...", "n_predict": 96, "reset": true}
+//   <- {"type":"ready","n_layer":16,"n_expert":64,"n_expert_used":8}
+//   <- {"type":"prefill","counts":{"0":[...], ...}}
+//   <- {"type":"token","text":"Hello","routes":{"0":[3,17,...], ...}}
+//   <- {"type":"done","n_tokens":42,"ms":1234}
+
+#include "arg.h"
+#include "common.h"
+#include "log.h"
+#include "llama.h"
+
+#include "ggml-backend.h"
+#include <nlohmann/json.hpp>
+
+#include <chrono>
+#include <clocale>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <iostream>
+#include <map>
+#include <sstream>
+#include <string>
+#include <vector>
+
+using json = nlohmann::json;
+
+struct routing_capture {
+    std::map<int, std::vector<int64_t>> counts;  // layer -> per-expert totals (trace mode)
+    std::map<int, std::vector<int>>     routes;  // layer -> experts chosen by the newest token
+    bool collect_routes = false;
+};
+
+static bool routing_cb(ggml_tensor * t, bool ask, void * user_data) {
+    static const char prefix[] = "ffn_moe_topk-";
+    if (strncmp(t->name, prefix, sizeof(prefix) - 1) != 0) {
+        return !ask;
+    }
+    if (ask) {
+        return true;
+    }
+    auto * d = (routing_capture *) user_data;
+    const int il = atoi(t->name + sizeof(prefix) - 1);
+    auto & counts = d->counts[il];
+    std::vector<int> * routes = d->collect_routes ? &d->routes[il] : nullptr;
+    if (routes) {
+        routes->clear();
+    }
+    // i32 [n_expert_used, n_tokens], possibly a non-contiguous view
+    for (int64_t j = 0; j < t->ne[1]; j++) {
+        for (int64_t k = 0; k < t->ne[0]; k++) {
+            int32_t e;
+            ggml_backend_tensor_get(t, &e, k * t->nb[0] + j * t->nb[1], sizeof(e));
+            if (e < 0) {
+                continue;
+            }
+            if ((size_t) e >= counts.size()) {
+                counts.resize(e + 1, 0);
+            }
+            counts[e]++;
+            if (routes && j == t->ne[1] - 1) {
+                routes->push_back(e);
+            }
+        }
+    }
+    return true;
+}
+
+static std::vector<std::string> read_prompts(const std::string & path) {
+    std::ifstream f(path);
+    std::vector<std::string> prompts;
+    std::string line, cur;
+    while (std::getline(f, line)) {
+        if (line == "---") {
+            if (!cur.empty()) prompts.push_back(cur);
+            cur.clear();
+        } else {
+            cur += (cur.empty() ? "" : "\n") + line;
+        }
+    }
+    if (!cur.empty()) prompts.push_back(cur);
+    return prompts;
+}
+
+static std::string apply_template(const llama_model * model, const std::string & user) {
+    const char * tmpl = llama_model_chat_template(model, nullptr);
+    llama_chat_message msg = { "user", user.c_str() };
+    std::vector<char> buf(user.size() * 2 + 4096);
+    int n = llama_chat_apply_template(tmpl, &msg, 1, true, buf.data(), buf.size());
+    if (n > (int) buf.size()) {
+        buf.resize(n);
+        n = llama_chat_apply_template(tmpl, &msg, 1, true, buf.data(), buf.size());
+    }
+    return n < 0 ? user : std::string(buf.data(), n);
+}
+
+static bool decode_all(llama_context * ctx, std::vector<llama_token> & tokens, int n_batch) {
+    for (size_t i = 0; i < tokens.size(); i += n_batch) {
+        const int n = std::min((int) (tokens.size() - i), n_batch);
+        if (llama_decode(ctx, llama_batch_get_one(tokens.data() + i, n))) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static void emit(const json & j) {
+    std::cout << j.dump() << std::endl;
+}
+
+static int run_serve(llama_context * ctx, const llama_model * model, common_params & params, routing_capture & cap) {
+    const llama_vocab * vocab = llama_model_get_vocab(model);
+    auto meta = [model](const std::string & key) {
+        char buf[128] = {0};
+        return llama_model_meta_val_str(model, key.c_str(), buf, sizeof(buf)) < 0 ? std::string() : std::string(buf);
+    };
+    const std::string arch = meta("general.architecture");
+
+    emit({{"type", "ready"},
+          {"model", meta("general.name")},
+          {"arch", arch},
+          {"n_layer", llama_model_n_layer(model)},
+          {"n_expert", atoi(meta(arch + ".expert_count").c_str())},
+          {"n_expert_used", atoi(meta(arch + ".expert_used_count").c_str())}});
+
+    std::string line;
+    while (std::getline(std::cin, line)) {
+        if (line.empty()) {
+            continue;
+        }
+        json req;
+        try {
+            req = json::parse(line);
+        } catch (const std::exception & e) {
+            emit({{"type", "error"}, {"message", std::string("bad json: ") + e.what()}});
+            continue;
+        }
+
+        const std::string user = req.value("prompt", "");
+        const int n_predict = req.value("n_predict", 96);
+        if (req.value("reset", true)) {
+            llama_memory_clear(llama_get_memory(ctx), true);
+        }
+
+        const std::string prompt = req.value("raw", false) ? user : apply_template(model, user);
+        std::vector<llama_token> tokens = common_tokenize(ctx, prompt, true, true);
+
+        cap.counts.clear();
+        cap.collect_routes = false;
+        const auto t0 = std::chrono::steady_clock::now();
+        if (!decode_all(ctx, tokens, params.n_batch)) {
+            emit({{"type", "error"}, {"message", "decode failed"}});
+            continue;
+        }
+        json prefill = json::object();
+        for (auto & [il, c] : cap.counts) {
+            prefill[std::to_string(il)] = c;
+        }
+        emit({{"type", "prefill"}, {"n_prompt_tokens", tokens.size()}, {"counts", prefill}});
+
+        cap.collect_routes = true;
+        llama_sampler * smpl = llama_sampler_init_greedy();
+        int n_gen = 0;
+        for (int i = 0; i < n_predict; i++) {
+            llama_token tok = llama_sampler_sample(smpl, ctx, -1);
+            if (llama_vocab_is_eog(vocab, tok)) {
+                break;
+            }
+            cap.routes.clear();
+            if (llama_decode(ctx, llama_batch_get_one(&tok, 1))) {
+                emit({{"type", "error"}, {"message", "decode failed"}});
+                break;
+            }
+            json routes = json::object();
+            for (auto & [il, r] : cap.routes) {
+                routes[std::to_string(il)] = r;
+            }
+            emit({{"type", "token"}, {"text", common_token_to_piece(ctx, tok)}, {"routes", routes}});
+            n_gen++;
+        }
+        llama_sampler_free(smpl);
+        cap.collect_routes = false;
+        const auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - t0).count();
+        emit({{"type", "done"}, {"n_tokens", n_gen}, {"ms", ms}});
+    }
+    return 0;
+}
+
+int main(int argc, char ** argv) {
+    std::setlocale(LC_NUMERIC, "C");
+
+    const char * mode_env = getenv("MOE_MODE");
+    const std::string mode = mode_env ? mode_env : "";
+    const bool serve = mode == "serve";
+    const bool trace = mode == "trace";
+    const char * prompts_path = getenv("MOE_PROMPTS");
+    const char * out_path = getenv("MOE_OUT");
+    const bool use_template = getenv("MOE_TEMPLATE") && atoi(getenv("MOE_TEMPLATE")) != 0;
+    if (mode.empty() || (!serve && (!prompts_path || !out_path))) {
+        fprintf(stderr, "set MOE_MODE (trace|gen|serve); trace/gen also need MOE_PROMPTS and MOE_OUT\n");
+        return 1;
+    }
+    if (serve) {
+        // per-token graph builds, so live steering edits are picked up between tokens
+        setenv("LLAMA_GRAPH_REUSE_DISABLE", "1", 0);
+    }
+
+    common_params params;
+    common_init();
+    if (!common_params_parse(argc, argv, params, LLAMA_EXAMPLE_COMMON)) {
+        return 1;
+    }
+    llama_backend_init();
+
+    routing_capture cap;
+    if (trace || serve) {
+        params.cb_eval = routing_cb;
+        params.cb_eval_user_data = &cap;
+    }
+    params.warmup = false;
+
+    auto llama_init = common_init_from_params(params);
+    auto * model = llama_init->model();
+    auto * ctx   = llama_init->context();
+    if (model == nullptr || ctx == nullptr) {
+        LOG_ERR("failed to init\n");
+        return 1;
+    }
+    const llama_vocab * vocab = llama_model_get_vocab(model);
+    const int n_predict = params.n_predict > 0 ? params.n_predict : 64;
+
+    if (serve) {
+        const int rc = run_serve(ctx, model, params, cap);
+        llama_backend_free();
+        return rc;
+    }
+
+    std::ofstream out(out_path);
+    int64_t n_tokens_total = 0;
+
+    for (const auto & raw : read_prompts(prompts_path)) {
+        const std::string prompt = use_template ? apply_template(model, raw) : raw;
+        std::vector<llama_token> tokens = common_tokenize(ctx, prompt, true, true);
+        llama_memory_clear(llama_get_memory(ctx), true);
+        if (!decode_all(ctx, tokens, params.n_batch)) {
+            LOG_ERR("decode failed\n");
+            return 1;
+        }
+        n_tokens_total += tokens.size();
+        if (trace) {
+            continue;
+        }
+
+        llama_sampler * smpl = llama_sampler_init_greedy();
+        std::string text;
+        for (int i = 0; i < n_predict; i++) {
+            llama_token tok = llama_sampler_sample(smpl, ctx, -1);
+            if (llama_vocab_is_eog(vocab, tok)) {
+                break;
+            }
+            text += common_token_to_piece(ctx, tok);
+            if (llama_decode(ctx, llama_batch_get_one(&tok, 1))) {
+                LOG_ERR("decode failed\n");
+                return 1;
+            }
+        }
+        llama_sampler_free(smpl);
+        out << json({{"prompt", raw}, {"output", text}}).dump() << "\n";
+        out.flush();
+        fprintf(stderr, "[gen] %s\n", text.substr(0, 120).c_str());
+    }
+
+    if (trace) {
+        json counts = json::object();
+        for (auto & [il, c] : cap.counts) {
+            counts[std::to_string(il)] = c;
+        }
+        out << json({{"n_tokens", n_tokens_total}, {"counts", counts}}).dump() << "\n";
+    }
+
+    llama_backend_free();
+    return 0;
+}
